* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

body {
    color: white;
    font-size: 40px;
}

#header {
    min-height: 1200vh;
    height: 100vh;
    background-color: rgb(45, 23, 255);
    position: relative;
}

nav {
    height: 60px;
    background-color: rgba#00ff00;
    margin-bottom: 20px;
}
/* 类选择器 */
.wrap{
    width: 1200px;
    margin: 0 auto;

}
.container-row{
    display: flex;
    gap: 10px;
}

mian{
    background-color: rgba(255, 0, 0);
    height: 3000px;
    width: 780%;
}

aside{
    background-color: rgba(0, 255, 225);
    height: 100px;
}

footer{
    background-color: rgba(255, 255, 0);
    height: 80px;
    /*文字垂直居中*/
    line-height: 80px;
    text-align: center;
    font-size: 20px;
}
.fixed-ad{
    /* 固定定位 */
    position: fixed;
    bottom: 0;
    right: 0;
    width: 200px;
    height: 200px;
    border: 2px solid black;
    /*z-index: 5; 让广告层在最上层显示*/
    z-index: 5;
    background-color: rgba(255, 0, 255, 0.5);
}
.logo{
    position: absolute;
    top: 0px;
    left: 0px;
    width: 100px;
    height: 89px;
    background-color: rgba(255, 0, 0, 0.5);
}
login{
    position: absolute;
    top: 0px;
    right: 0px;
    width: 100px;
    height: 89px;
    background-color: rgba(255, 255, 0, 0.5);
}
